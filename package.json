{
  "name": "relic-vault",
  "version": "1.0.0",
  "description": "Relic Vault: merge cursed treasure in a living vault. Mobile-first Phaser PWA.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/version.mjs",
    "build": "vite build",
    "preview": "vite preview --port 4173",
    "test": "node scripts/test-strict.mjs",
    "typecheck": "tsc --noEmit -p .",
    "test:e2e": "playwright test",
    "icons": "node apps/web/tools/make-icons.mjs",
    "playtest": "node apps/web/tools/play.mjs http://127.0.0.1:5173/ screenshots/playtest full",
    "test:plain": "vitest run",
    "version": "node scripts/version.mjs --release && git add CHANGELOG.md"
  },
  "dependencies": {
    "@fontsource/cinzel": "^5.3.0",
    "@fontsource/oswald": "^5.3.0",
    "idb-keyval": "^6.3.0",
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.1"
  }
}
