<?xml version="1.0" encoding="utf-8"?>
<!-- AB#4723: Android 12 and later, cloud backup and device-to-device transfer alike: the WebView's storage stays on
     the phone it was made on (see backup_rules.xml for why). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="app_webview/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="app_webview/" />
    </device-transfer>
</data-extraction-rules>
